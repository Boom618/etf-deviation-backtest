/* pages/index/index.wxss */

.loading-box {
  background: var(--card);
  border: 1rpx solid var(--line-2);
  border-radius: 16rpx;
  padding: 30rpx 50rpx;
  font-size: 28rpx;
  color: var(--txt-2);
}

.date-row {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  flex-wrap: wrap;
}

.date-label { color: var(--txt-3); margin-right: 8rpx; }
.date-val {
  color: var(--txt);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  margin-right: 24rpx;
}

.note-text {
  font-size: 24rpx;
  color: var(--txt-3);
  line-height: 1.7;
}

/* ---- 代码输入 ---- */
.code-row {
  display: flex;
  align-items: center;
}

.code-input {
  flex: 1;
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
  color: var(--txt);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  margin-right: 16rpx;
  height: 88rpx;
}

.btn-small {
  background: var(--accent);
  border: none;
  border-radius: 12rpx;
  color: #fff;
  font-size: 26rpx;
  line-height: 86rpx;
  height: 88rpx;
  width: 130rpx;
  padding: 0;
  margin: 0;
  font-weight: 500;
}

.btn-small::after { border: none; }
.btn-small.busy { opacity: .6; }

.code-hint {
  font-size: 23rpx;
  color: var(--txt-3);
  margin-top: 12rpx;
}

.code-hint.ok { color: var(--accent-2); }
.code-hint.err { color: var(--up); }

