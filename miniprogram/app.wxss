/* app.wxss —— 全局样式
 * 颜色与网页版 style.css 的 :root 保持一致
 */

page {
  --bg: #0b0e14;
  --panel: #12161f;
  --card: #151a24;
  --card-h: #1a202b;
  --line: rgba(255, 255, 255, 0.075);
  --line-2: rgba(255, 255, 255, 0.13);
  --txt: #e6edf3;
  --txt-2: #9aa4b2;
  --txt-3: #6b7480;
  --up: #f85149;
  --down: #2ea043;
  --accent: #388bfd;
  --accent-2: #58a6ff;
  --gold: #d9a441;

  background: var(--bg);
  color: var(--txt);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
}

view, text, scroll-view, button, input, picker, slider {
  box-sizing: border-box;
}

/* ---------- 布局 ---------- */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 24rpx 20rpx;
}

.card-title {
  font-size: 24rpx;
  color: var(--txt-2);
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 表单 ---------- */
.field {
  margin-bottom: 22rpx;
}

.field:last-child { margin-bottom: 0; }

.field-label {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  font-size: 25rpx;
  color: var(--txt-2);
  margin-bottom: 12rpx;
}

.field-hint { font-size: 22rpx; color: var(--txt-3); }

.input {
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--txt);
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

.picker-box {
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  border-radius: 12rpx;
  padding: 18rpx 20rpx;
  font-size: 28rpx;
  color: var(--txt);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-val { color: var(--txt); }
.picker-arrow { color: var(--txt-3); font-size: 24rpx; }

/* 滑块 */
.slider-row {
  display: flex;
  align-items: center;
}

.slider { flex: 1; margin: 0 20rpx 0 0; }

.slider-num {
  width: 140rpx;
  background: var(--bg);
  border: 1rpx solid var(--line-2);
  border-radius: 12rpx;
  padding: 14rpx 12rpx;
  font-size: 26rpx;
  color: var(--txt);
  text-align: center;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}

/* 快捷按钮 */
.chips {
  display: flex;
  flex-wrap: wrap;
  margin: -6rpx -6rpx 0;
}

.chip {
  padding: 12rpx 22rpx;
  margin: 6rpx;
  border: 1rpx solid var(--line-2);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--txt-2);
  background: transparent;
  line-height: 1.4;
}

.chip.on {
  background: rgba(56, 139, 253, 0.16);
  border-color: var(--accent);
  color: var(--accent-2);
}

/* ---------- 按钮 ---------- */
.btn {
  border-radius: 14rpx;
  font-size: 30rpx;
  padding: 0;
  line-height: 88rpx;
  height: 88rpx;
  border: 1rpx solid var(--line-2);
  background: var(--card-h);
  color: var(--txt);
  margin: 0;
}

.btn::after { border: none; }

.btn.primary {
  background: var(--accent);
  border-color: var(--accent);
  color: #fff;
  font-weight: 500;
}

/* ---------- 指标 ---------- */
.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  margin: -8rpx -8rpx 0;
}

.kpi {
  width: calc(50% - 16rpx);
  margin: 8rpx;
  background: var(--bg);
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx;
}

.kpi-label { font-size: 22rpx; color: var(--txt-3); margin-bottom: 8rpx; }

.kpi-value {
  font-size: 40rpx;
  font-weight: 600;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  line-height: 1.2;
}

.kpi-sub { font-size: 21rpx; color: var(--txt-3); margin-top: 6rpx; }

.up { color: var(--up); }
.down { color: var(--down); }
.flat { color: var(--txt); }

/* ---------- 指标表 ---------- */
.metric-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--line);
  font-size: 26rpx;
}

.metric-row:last-child { border-bottom: none; }
.metric-name { color: var(--txt-2); }
.metric-val {
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  color: var(--txt);
}

/* ---------- 图表 ---------- */
.chart-wrap {
  position: relative;
  width: 100%;
  height: 380rpx;
  background: var(--card);
  border-radius: 16rpx;
  overflow: hidden;
}

.chart-canvas { width: 100%; height: 100%; display: block; }

.chart-tip {
  position: absolute;
  background: rgba(10, 13, 19, 0.95);
  border: 1rpx solid var(--line-2);
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  line-height: 1.7;
  pointer-events: none;
  z-index: 10;
  min-width: 240rpx;
}

.tip-row { display: flex; justify-content: space-between; }
.tip-label { color: var(--txt-3); }
.tip-val { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--txt); }
.tip-sig { margin-top: 6rpx; font-size: 22rpx; }

/* ---------- 成交明细 ---------- */
.trade-item {
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.trade-item:last-child { border-bottom: none; }

.trade-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.trade-no { font-size: 22rpx; color: var(--txt-3); }
.trade-pnl { font-size: 30rpx; font-weight: 600; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }

.trade-grid {
  display: flex;
  flex-wrap: wrap;
  font-size: 23rpx;
  color: var(--txt-2);
}

.trade-cell { width: 50%; padding: 5rpx 0; }
.trade-cell .k { color: var(--txt-3); }
.trade-cell .v { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; color: var(--txt); }

/* ---------- 其它 ---------- */
.empty {
  text-align: center;
  color: var(--txt-3);
  font-size: 26rpx;
  padding: 80rpx 40rpx;
}

.loading-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(11, 14, 20, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.warn-box {
  background: rgba(217, 164, 65, 0.1);
  border: 1rpx solid rgba(217, 164, 65, 0.3);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 24rpx;
  color: #e0b968;
  margin: 0 24rpx 20rpx;
}
